{
  "name": "emperador-santiago",
  "private": true,
  "workspaces": [
    "shared",
    "web",
    "bridge",
    "remotion"
  ],
  "scripts": {
    "dev": "npm run dev -w web & npm run dev -w bridge",
    "build": "npm run build -w web",
    "mcp": "npm run mcp -w bridge",
    "learn": "npm run learn -w bridge --",
    "remotion:studio": "npm run studio -w remotion",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "setup": "bash scripts/setup.sh",
    "setup:rea": "bash scripts/setup-rea.sh",
    "skills": "bash scripts/instalar-skills.sh",
    "setup:ves": "bash scripts/setup-ves.sh",
    "unir": "npm run unir -w bridge --",
    "start": "npm run start -w bridge",
    "build:nube": "VITE_SANTI_BRIDGE= npm run build -w web"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
